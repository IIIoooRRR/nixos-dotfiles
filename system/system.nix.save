{ config, pkgs, ... }:
{
  swapDevices = [
    { device = "/var/lib/swapfile
  ];
  hardware = {
    steam-hardware.enable = true;
    graphics = {
      enable = true;
      enable32Bit = true;

      extraPackages = with pkgs; [ 
        intel-media-driver
        vulkan-loader
      ];
      extraPackages32 = with pkgs.pkgsi686Linux; [ 
        intel-vaapi-driver
        vulkan-loader
      ]; 
    };
  };
  home-manager.users.kezess = {
    home.file.".android/advancedFeatures.ini".text = ''
    Vulkan = off
    GLDirectMem = on
    '';
  };
}
